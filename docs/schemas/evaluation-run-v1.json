{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "evaluation-run-v1.json",
  "title": "AgentShield evaluation run summary",
  "description": "One EvaluationRun row (work package 4) — a policy/grant simulation against a synthetic fixture suite. No tool call ever occurred as part of the run this summarizes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "suiteId", "suiteVersion", "startedAt", "totalCases", "passedCases", "failedCases", "errorCases"],
  "properties": {
    "schemaVersion": { "const": "evaluation-run-v1" },
    "id": { "type": "integer" },
    "suiteId": { "type": "integer" },
    "suiteVersion": { "type": "integer" },
    "policyConfigFingerprint": { "type": ["string", "null"], "description": "e.g. grants-transition-mode=GRANTS_REQUIRED — identifies which configuration this run was evaluated against." },
    "triggeredBy": { "type": ["string", "null"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "totalCases": { "type": "integer", "minimum": 0 },
    "passedCases": { "type": "integer", "minimum": 0 },
    "failedCases": { "type": "integer", "minimum": 0 },
    "errorCases": { "type": "integer", "minimum": 0 }
  }
}
